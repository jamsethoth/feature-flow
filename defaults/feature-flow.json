{
  "plan":      { "cli": "claude", "model": "opus",        "effort": "high",   "persona": "planner" },
  "implement": { "cli": "claude", "model": "sonnet",      "effort": "medium", "persona": "implementer" },
  "review":    { "cli": "codex",  "model": "gpt-6.1-sol", "effort": "medium", "persona": "reviewer" },
  "escalate":  { "cli": "claude", "model": "opus",        "effort": "high",   "persona": "escalator" },
  "planApproval": true,
  "escalationEnabled": false,
  "maxParallel": 2,
  "stuckAfterHours": 6,
  "maxReviewRounds": 2,
  "baseBranch": "main",
  "worktreeRoot": "~/worktrees",
  "allowNetwork": false,
  "style": { "internal": "none" },
  "toolkit": {
    "claude": { "hooks": [] },
    "codex": {
      "useUserConfig": true,
      "disableMcp": true,
      "hooks": false,
      "windowsSandbox": "mxc",
      "disableFeatures": [],
      "inject": ["ponytail"],
      "disablePlugins": ["computer-use@openai-bundled", "unified-computer-use@openai-bundled", "browser@openai-bundled", "chrome@openai-bundled", "codex-app-tools@openai-bundled"]
    }
  },
  "contextBudget": { "plan": 100000, "review": 100000, "escalate": 100000, "byModel": {} },
  "apiPrices": {
    "gpt-6.1-sol": { "input": 2.0, "cachedInput": 0.1, "cacheWrite": 2.5, "output": 10.0, "source": "https://developers.openai.com/api/docs/pricing" }
  },
  "stageTools": {
    "plan":      { "skills": ["grilling", "to-tickets", "writing-for-agents"], "mcp": [], "plugins": [] },
    "implement": { "skills": ["mattpocock-skills:tdd"], "mcp": [], "plugins": ["ponytail"] },
    "review":    { "skills": ["mattpocock-skills:code-review"], "mcp": [], "plugins": ["ponytail"] },
    "escalate":  { "skills": ["mattpocock-skills:diagnosing-bugs", "mattpocock-skills:tdd"], "mcp": [], "plugins": ["ponytail"] }
  }
}
