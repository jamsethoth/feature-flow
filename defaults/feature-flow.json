{
  "plan":      { "cli": "claude", "model": "opus",        "effort": "high",   "persona": "planner" },
  "implement": { "cli": "claude", "model": "sonnet",      "effort": "medium", "persona": "implementer" },
  "review":    { "cli": "codex",  "model": "gpt-6.1-sol", "effort": "medium", "persona": "reviewer" },
  "escalate":  { "cli": "claude", "model": "opus",        "effort": "high",   "persona": "escalator" },
  "planApproval": true,
  "escalationEnabled": false,
  "maxParallel": 2,
  "maxReviewRounds": 2,
  "baseBranch": "main",
  "worktreeRoot": "~/worktrees",
  "allowNetwork": false,
  "style": { "internal": "none" },
  "toolkit": {
    "claude": { "hooks": [], "plugins": ["ponytail", "mattpocock-skills"] },
    "codex": { "useUserConfig": true, "disableMcp": true }
  },
  "stageSkills": {
    "plan": ["grilling", "to-tickets", "writing-for-agents"],
    "implement": ["tdd"],
    "review": ["code-review"],
    "escalate": ["diagnosing-bugs", "tdd"]
  }
}
